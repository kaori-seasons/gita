[Unit]
Description=Rust Edge Compute Framework Service
Documentation=file:///opt/edge-compute/docs/DEPLOYMENT_GUIDE.md
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=edge-compute
Group=edge-compute
WorkingDirectory=/opt/edge-compute

# Main executable
ExecStart=/opt/edge-compute/bin/rust-edge-compute

# Restart policy
Restart=on-failure
RestartSec=10s
StartLimitInterval=60s
StartLimitBurst=3

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/edge-compute/data /var/log/edge-compute

# Resource limits
LimitNOFILE=65536
LimitNPROC=65536
MemoryMax=4G
CPUQuota=80%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=edge-compute

# Environment
EnvironmentFile=/opt/edge-compute/etc/edge-compute.env
Environment="RUST_LOG=info"
Environment="RUST_BACKTRACE=1"

# Process management
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
