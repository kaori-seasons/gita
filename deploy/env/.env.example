# Environment Variables for Rust Edge Compute Framework
# Bare Metal Deployment Configuration
# Source this file: source deploy/env/.env.example

# ═══════════════════════════════════════════════════════════════════
# Application Configuration
# ═══════════════════════════════════════════════════════════════════

# Application identity
APP_NAME=rust-edge-compute
APP_VERSION=0.1.0
ENVIRONMENT=production

# Logging
RUST_LOG=info
RUST_LOG_STYLE=always
RUST_BACKTRACE=1

# ═══════════════════════════════════════════════════════════════════
# Server Configuration
# ═══════════════════════════════════════════════════════════════════

# Listen configuration
LISTEN_HOST=0.0.0.0
LISTEN_PORT=3000
WORKERS=4

# HTTP settings
REQUEST_TIMEOUT_SECONDS=300
KEEP_ALIVE_SECONDS=75
MAX_CONNECTIONS=1000

# ═══════════════════════════════════════════════════════════════════
# Database Configuration
# ═══════════════════════════════════════════════════════════════════

# Database type: sled, sqlite, postgres
DB_TYPE=sled
DB_PATH=/opt/edge-compute/data/db
DB_CACHE_SIZE_MB=512

# PostgreSQL (if using postgres)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=edge_compute
# DB_USER=edge_user
# DB_PASSWORD=change_this_password

# ═══════════════════════════════════════════════════════════════════
# Redis Configuration (Optional)
# ═══════════════════════════════════════════════════════════════════

# REDIS_URL=redis://localhost:6379
# REDIS_DB=0
# REDIS_PASSWORD=

# ═══════════════════════════════════════════════════════════════════
# Security Configuration
# ═══════════════════════════════════════════════════════════════════

# Authentication
AUTH_ENABLED=true
JWT_SECRET=change_this_secret_to_something_random
JWT_EXPIRATION_HOURS=24

# TLS/SSL
TLS_ENABLED=false
TLS_CERT_PATH=/opt/edge-compute/etc/certs/server.pem
TLS_KEY_PATH=/opt/edge-compute/etc/certs/server.key

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW_SECONDS=60

# CORS
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=*

# ═══════════════════════════════════════════════════════════════════
# Storage Configuration
# ═══════════════════════════════════════════════════════════════════

# File storage paths
CONFIG_PATH=/opt/edge-compute/etc/production.toml
LOG_PATH=/var/log/edge-compute/app.log
DATA_PATH=/opt/edge-compute/data
BACKUP_PATH=/opt/edge-compute/backups

# Storage settings
LOG_MAX_SIZE_MB=100
LOG_MAX_BACKUPS=10
LOG_COMPRESS=true

# ═══════════════════════════════════════════════════════════════════
# Monitoring Configuration
# ═══════════════════════════════════════════════════════════════════

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_INTERVAL_SECONDS=60

# Tracing/APM
TRACING_ENABLED=false
TRACING_JAEGER_ENDPOINT=http://localhost:14268/api/traces
TRACING_SAMPLE_RATE=0.1

# ═══════════════════════════════════════════════════════════════════
# Scheduler Configuration
# ═══════════════════════════════════════════════════════════════════

# Task scheduling
MAX_CONCURRENT_TASKS=100
TASK_QUEUE_SIZE=10000
TASK_TIMEOUT_SECONDS=300
DEFAULT_MAX_RETRIES=3
INTELLIGENT_SCHEDULING_ENABLED=false

# ═══════════════════════════════════════════════════════════════════
# Container Configuration (if used)
# ═══════════════════════════════════════════════════════════════════

# Container runtime
CONTAINER_RUNTIME=youki
CONTAINER_RUNTIME_PATH=/usr/bin/youki
CONTAINER_ROOT=/opt/edge-compute/containers

# Container settings
ENABLE_CGROUPS=true
CONTAINER_NETWORK_MODE=host
CONTAINER_LOG_DRIVER=json-file

# ═══════════════════════════════════════════════════════════════════
# OTA Update Configuration
# ═══════════════════════════════════════════════════════════════════

# Auto-update settings
AUTO_CHECK_UPDATES=true
UPDATE_CHECK_INTERVAL_SECONDS=3600
UPDATE_SERVER_URL=https://updates.example.com
ALLOW_DOWNGRADES=false
BACKUP_OLD_VERSION=true

# ═══════════════════════════════════════════════════════════════════
# Performance Tuning
# ═══════════════════════════════════════════════════════════════════

# Compression
ENABLE_COMPRESSION=true
COMPRESSION_LEVEL=6
COMPRESSION_MIN_SIZE_BYTES=1024

# Buffer settings
BUFFER_SIZE=65536
MAX_BODY_SIZE_MB=100
CONNECTION_POOL_SIZE=128

# I/O optimization
USE_EPOLL=true
USE_MMAP=false

# ═══════════════════════════════════════════════════════════════════
# Development/Debug Options
# ═══════════════════════════════════════════════════════════════════

# Uncomment for development/testing
# DEBUG_MODE=true
# VERBOSE_LOGGING=true
# DISABLE_AUTH=false
# MOCK_EXTERNAL_SERVICES=false
